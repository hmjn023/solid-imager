FROM oven/bun:1.4.4-debian AS dependencies
WORKDIR /app
COPY . .
RUN HUSKY=0 bun install --frozen-lockfile --production --filter @solid-imager/inference \
    && bun -e 'require("dghs-imgutils-rs").getVersion()'

FROM oven/bun:1.4.4-debian
RUN apt-get update \
    && apt-get install --no-install-recommends --yes ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && install -d -o bun -g bun /var/cache/inference
COPY --from=dependencies /app/node_modules /app/node_modules
COPY --from=dependencies /app/packages/core /app/packages/core
COPY --from=dependencies /app/apps/inference/src /app/apps/inference/src

WORKDIR /app/apps/inference
ENV INFERENCE_HOST=0.0.0.0 \
    INFERENCE_PORT=3001 \
    ORT_DYLIB_PATH=/opt/onnxruntime/lib/libonnxruntime.so \
    LD_LIBRARY_PATH=/opt/onnxruntime/lib \
    HF_HOME=/var/cache/inference/huggingface \
    IU_HOME=/var/cache/inference/dghs-imgutils
USER bun
CMD ["bun", "src/index.ts"]
