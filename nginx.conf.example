events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Media uploads are sent as multipart request bodies.
    client_max_body_size 100m;

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log;

    upstream solid_imager {
        server 127.0.0.1:${NITRO_PORT};
        # Compose を使う場合は上の行と入れ替える。
        # server app:${NITRO_PORT};
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' '';
    }

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    server {
        # mise のローカル検証ではループバックで待ち受ける。
        listen 127.0.0.1:${NGINX_PORT};
        # Compose や公開 HTTP では上の listen と入れ替える。
        # listen ${NGINX_PORT};

        # HTTPS を使う場合は HTTP の listen をコメントアウトし、以下を有効にする。
        # listen ${NGINX_TLS_PORT} ssl;
        # http2 on;
        # ssl_protocols TLSv1.2 TLSv1.3;
        # server_name imager.example.com;
        # ssl_certificate     /etc/letsencrypt/live/imager.example.com/fullchain.pem;
        # ssl_certificate_key /etc/letsencrypt/live/imager.example.com/privkey.pem;
        # add_header X-Frame-Options DENY;
        # add_header X-Content-Type-Options nosniff;

        # HTTP/3 を使う場合はさらに有効にする。
        # listen ${NGINX_TLS_PORT} quic reuseport;
        # http3 on;
        # add_header Alt-Svc 'h3=":${NGINX_TLS_PORT}"; ma=86400';

        # Flush oRPC SSE events as soon as the app sends them.
        location ~ ^/api/(sources/[^/]+|imports|jobs)/events$ {
            proxy_pass http://solid_imager;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 1h;
            proxy_send_timeout 1h;
        }

        location / {
            proxy_pass http://solid_imager;
        }
    }

    # HTTPS を使う場合に HTTP からリダイレクトする。
    # server {
    #     listen ${NGINX_PORT};
    #     server_name imager.example.com;
    #     return 301 https://$host:${NGINX_TLS_PORT}$request_uri;
    # }
}
