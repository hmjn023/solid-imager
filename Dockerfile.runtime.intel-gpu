FROM docker.io/oven/bun:1.4.4-debian AS bun
FROM docker.io/archlinux/archlinux:base

# Build context contains the tested ORT, OpenVINO and Intel GPU plugin packages.
COPY *.pkg.tar.zst /tmp/gpu-packages/
RUN pacman -Syu --noconfirm python ffmpeg ca-certificates \
    && pacman -U --noconfirm /tmp/gpu-packages/*.pkg.tar.zst \
    && rm -rf /tmp/gpu-packages /var/cache/pacman/pkg/*
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
ENV ORT_DYLIB_PATH=/usr/lib/libonnxruntime.so.1
