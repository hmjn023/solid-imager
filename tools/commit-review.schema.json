{
	"type": "object",
	"additionalProperties": false,
	"required": ["architecture", "mcp"],
	"properties": {
		"architecture": { "$ref": "#/$defs/check" },
		"mcp": { "$ref": "#/$defs/check" }
	},
	"$defs": {
		"check": {
			"type": "object",
			"additionalProperties": false,
			"required": ["status", "reason", "evidence", "required_actions"],
			"properties": {
				"status": {
					"type": "string",
					"enum": ["PASS", "NEEDS_CHANGE", "UNKNOWN"]
				},
				"reason": { "type": "string", "minLength": 1 },
				"evidence": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["path", "detail"],
						"properties": {
							"path": { "type": "string", "minLength": 1 },
							"detail": { "type": "string", "minLength": 1 }
						}
					}
				},
				"required_actions": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 }
				}
			}
		}
	}
}
