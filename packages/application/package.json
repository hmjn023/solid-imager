{
  "name": "@solid-imager/application",
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./services/*": "./src/services/*.ts",
    "./ports/*": "./src/ports/*.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "check": "biome check --fix --unsafe ./src",
    "typecheck": "sh -c 'tsc --noEmit'",
    "lint": "biome lint ./src",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.27.2",
    "@solid-imager/core": "workspace:*",
    "apache-arrow": "^21.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "rc",
    "vitest": "^4.1.10"
  }
}
