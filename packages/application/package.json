{
  "name": "@solid-imager/application",
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./services/*": "./src/services/*.ts",
    "./ports/*": "./src/ports/*.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "check": "oxlint --fix ./src && oxfmt --write ./src",
    "typecheck": "sh -c 'tsc --noEmit'",
    "lint": "oxlint ./src",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@solid-imager/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  }
}
