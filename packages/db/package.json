{
  "name": "@solid-imager/db",
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./types": "./src/types.ts",
    "./transaction-manager": "./src/transaction-manager.ts",
    "./errors": "./src/errors.ts",
    "./repositories/*": "./src/repositories/*.ts"
  },
  "scripts": {
    "check": "biome check --fix --unsafe ./src",
    "typecheck": "sh -c 'tsc --noEmit'",
    "lint": "biome lint ./src",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@solid-imager/core": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "rc",
    "vitest": "^4.1.10"
  }
}
