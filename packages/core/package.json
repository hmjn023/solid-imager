{
  "name": "@solid-imager/core",
  "version": "0.0.0",
  "private": true,
  "description": "Core business logic and interfaces for Solid Imager",
  "type": "module",
  "exports": {
    "./authors": "./src/public/authors.ts",
    "./categories": "./src/public/categories.ts",
    "./characters": "./src/public/characters.ts",
    "./collections": "./src/public/collections.ts",
    "./config": "./src/public/config.ts",
    "./contract": "./src/domain/contract/index.ts",
    "./danbooru": "./src/public/danbooru.ts",
    "./errors": "./src/domain/errors/index.ts",
    "./events": "./src/public/events.ts",
    "./http": "./src/domain/contract/http-paths.ts",
    "./ips": "./src/public/ips.ts",
    "./jobs": "./src/public/jobs.ts",
    "./media": "./src/public/media.ts",
    "./media-tools": "./src/public/media-tools.ts",
    "./media/files": "./src/public/media-files.ts",
    "./media/metadata": "./src/domain/media/utils/metadata-utils.ts",
    "./ports": "./src/public/ports.ts",
    "./presets": "./src/public/presets.ts",
    "./projects": "./src/public/projects.ts",
    "./search": "./src/public/search.ts",
    "./shared": "./src/public/shared.ts",
    "./sources": "./src/public/sources.ts",
    "./statistics": "./src/public/statistics.ts",
    "./tagging": "./src/public/tagging.ts",
    "./tags": "./src/public/tags.ts",
    "./thumbnails": "./src/public/thumbnails.ts",
    "./users": "./src/public/users.ts",
    "./utils": "./src/utils/index.ts"
  },
  "scripts": {
    "check": "oxlint --fix ./src && oxfmt --write ./src",
    "typecheck": "sh -c 'tsc --noEmit'",
    "lint": "oxlint ./src",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@orpc/contract": "2.0.0-beta.48",
    "@orpc/openapi": "2.0.0-beta.48",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
