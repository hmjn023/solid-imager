{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"isolatedModules": true,
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"include": ["src", "src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["node_modules", "dist", ".vinxi", ".output", "src-tauri"]
}
