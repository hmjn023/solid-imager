{
  "name": "@solid-imager/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "imager-cli": "./src/index.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --compile --outfile dist/imager-cli",
    "start": "bun run dist/imager-cli",
    "typecheck": "sh -c 'tsc --noEmit'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@orpc/client": "^1.15.0",
    "@solid-imager/client": "workspace:*",
    "@solid-imager/core": "workspace:*",
    "incur": "^0.5.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^26.4.0",
    "typescript": "rc",
    "vitest": "^4.1.11"
  }
}
