        "schema": "public",
        "table": "media_regions",
        "name": "media_regions_bbox_by_kind",
        "value": "(\n\t\t\t\t(\"kind\" = 'full' AND \"x\" IS NULL AND \"y\" IS NULL AND \"width\" IS NULL AND \"height\" IS NULL)\n\t\t\t\tOR\n\t\t\t\t(\"kind\" <> 'full' AND \"x\" IS NOT NULL AND \"y\" IS NOT NULL AND \"width\" IS NOT NULL AND \"height\" IS NOT NULL\n\t\t\t\t\tAND \"x\" >= 0 AND \"y\" >= 0 AND \"width\" > 0 AND \"height\" > 0\n\t\t\t\t\tAND \"x\" + \"width\" <= 1 AND \"y\" + \"height\" <= 1)\n\t\t\t)",
