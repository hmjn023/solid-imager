{
  "name": "@solid-imager/server",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./app-router": "./src/infrastructure/api/app-router.ts"
  },
  "scripts": {
    "dev": "bun --bun run vite dev",
    "build": "bun --bun run vite build",
    "preview": "bun --bun run vite preview",
    "start": "bun --bun --preload ./scripts/runtime-preload.ts .output/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reconcile-uuidv7-paths": "bun scripts/reconcile-uuidv7-paths.ts",
    "db:migrate:pglite": "bun scripts/migrate-pglite.ts",
    "db:push": "drizzle-kit push",
    "db:drop": "drizzle-kit drop",
    "db:studio": "drizzle-kit studio",
    "validate:native": "bun scripts/validate-native-runtime.ts",
    "validate:bun-image": "bun scripts/validate-bun-image.ts",
    "validate:bun-sql": "bun scripts/validate-bun-sql.ts",
    "openapi:generate": "bun scripts/generate-openapi.ts",
    "lint": "oxlint ./src",
    "format": "oxfmt --write ./src",
    "check": "oxlint --fix ./src && oxfmt --write ./src",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e:components && bun run test:e2e",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "bun scripts/run-e2e.ts --mode=all",
    "test:e2e:full": "bun scripts/run-e2e.ts --mode=all --full-dev",
    "test:e2e:dev": "bun scripts/run-e2e.ts --mode=dev",
    "test:e2e:production": "bun scripts/run-e2e.ts --mode=production",
    "test:e2e:quick": "bun scripts/run-e2e.ts --mode=all --project=desktop --project=responsive-desktop --project=responsive-375 --project=responsive-768",
    "test:e2e:quick:dev": "bun scripts/run-e2e.ts --mode=dev --project=desktop --project=responsive-desktop --project=responsive-375 --project=responsive-768",
    "test:e2e:quick:production": "bun scripts/run-e2e.ts --mode=production --project=desktop --project=responsive-desktop --project=responsive-375 --project=responsive-768",
    "test:e2e:playwright": "playwright test",
    "typecheck": "sh -c 'tsc --noEmit --project ./tsconfig.json'",
    "docs:generate": "typedoc",
    "test:e2e:components": "bun scripts/run-e2e.ts --mode=components"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-pgvector": "0.0.12",
    "@orpc/client": "^1.16.1",
    "@orpc/contract": "^1.16.1",
    "@orpc/experimental-pino": "^1.16.1",
    "@orpc/server": "^1.16.1",
    "@orpc/solid-query": "^1.16.1",
    "@orpc/tanstack-query": "^1.16.1",
    "@orpc/zod": "^1.16.1",
    "@scalar/api-reference": "^1.76.2",
    "@solid-imager/application": "workspace:*",
    "@solid-imager/client": "workspace:*",
    "@solid-imager/core": "workspace:*",
    "@solid-imager/db": "workspace:*",
    "@solid-imager/ui": "workspace:*",
    "@tanstack/query-core": "5.105.0",
    "@tanstack/router-plugin": "1.168.48",
    "@tanstack/solid-form": "^1.33.5",
    "@tanstack/solid-query": "5.105.0",
    "@tanstack/solid-router": "1.170.43",
    "@tanstack/solid-router-devtools": "^1.167.2",
    "@tanstack/solid-router-ssr-query": "^1.167.3",
    "@tanstack/solid-start": "1.169.4",
    "archiver": "^8.0.0",
    "chokidar": "6.0.0",
    "dghs-imgutils-rs": "github:hmjn023/dghs-imgutils-rs#v0.5.4",
    "drizzle-orm": "^0.45.4",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "nitro": "npm:nitro-nightly@3.0.1-20261024-005652-6bccaad1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "solid-js": "^1.9.17",
    "uuid": "^14.0.3",
    "yauzl": "^3.4.0",
    "youtube-dl-exec": "^3.1.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@orpc/openapi": "^1.16.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@types/archiver": "^8.0.0",
    "@types/ffmpeg-static": "^5.1.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "^5.0.5",
    "baseline-browser-mapping": "^2.11.34",
    "bun-types": "1.4.4",
    "dotenv": "18.0.9",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  }
}
