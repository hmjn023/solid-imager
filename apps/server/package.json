{
  "name": "@solid-imager/server",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./app-router": "./src/infrastructure/api/app-router.ts"
  },
  "scripts": {
    "dev": "bun --bun run vite dev",
    "build": "bun --bun run vite build",
    "preview": "bun --bun run vite preview",
    "start": "bun --bun .output/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reconcile-uuidv7-paths": "bun scripts/reconcile-uuidv7-paths.ts",
    "db:migrate:pglite": "bun scripts/migrate-pglite.ts",
    "db:push": "drizzle-kit push",
    "db:drop": "drizzle-kit drop",
    "db:studio": "drizzle-kit studio",
    "validate:native": "bun scripts/validate-native-runtime.ts",
    "validate:bun-image": "bun scripts/validate-bun-image.ts",
    "validate:bun-sql": "bun scripts/validate-bun-sql.ts",
    "lint": "biome lint ./src",
    "format": "biome format --fix ./src",
    "check": "biome check --fix --unsafe ./src",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "bun scripts/run-e2e.ts --mode=all",
    "test:e2e:dev": "bun scripts/run-e2e.ts --mode=dev",
    "test:e2e:production": "bun scripts/run-e2e.ts --mode=production",
    "test:e2e:quick": "bun scripts/run-e2e.ts --mode=all --project=desktop --project=responsive-375 --project=responsive-768",
    "test:e2e:quick:dev": "bun scripts/run-e2e.ts --mode=dev --project=desktop --project=responsive-375 --project=responsive-768",
    "test:e2e:quick:production": "bun scripts/run-e2e.ts --mode=production --project=desktop --project=responsive-375 --project=responsive-768",
    "test:e2e:playwright": "playwright test",
    "typecheck": "sh -c 'tsc --noEmit --project ./tsconfig.json'",
    "docs:generate": "typedoc"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@orpc/client": "^1.15.0",
    "@orpc/contract": "^1.15.0",
    "@orpc/experimental-pino": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@orpc/solid-query": "^1.15.0",
    "@orpc/tanstack-query": "^1.15.0",
    "@orpc/zod": "^1.15.0",
    "@solid-imager/application": "workspace:*",
    "@solid-imager/client": "workspace:*",
    "@solid-imager/core": "workspace:*",
    "@solid-imager/db": "workspace:*",
    "@solid-imager/ui": "workspace:*",
    "@tanstack/query-core": "5.102.8",
    "@tanstack/router-plugin": "^1.168.35",
    "@tanstack/solid-form": "^1.33.5",
    "@tanstack/solid-query": "5.102.8",
    "@tanstack/solid-router": "1.170.30",
    "@tanstack/solid-router-devtools": "^1.167.1",
    "@tanstack/solid-router-ssr-query": "^1.167.2",
    "@tanstack/solid-start": "^1.168.47",
    "archiver": "^8.0.0",
    "chokidar": "^5.0.0",
    "dghs-imgutils-rs": "github:hmjn023/dghs-imgutils-rs#v0.5.2",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "nitro": "npm:nitro-nightly@3.0.1-20260601-173724-a2597363",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.4",
    "solid-js": "^1.9.15",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-dist": "^5.32.14",
    "uuid": "^14.0.2",
    "yauzl": "^3.4.0",
    "youtube-dl-exec": "^3.1.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@orpc/openapi": "^1.15.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@types/archiver": "^8.0.0",
    "@types/ffmpeg-static": "^5.1.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-dist": "^3.30.6",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "baseline-browser-mapping": "^2.11.20",
    "bun-types": "1.4.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typescript": "rc",
    "vite": "^8.2.2",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  }
}
