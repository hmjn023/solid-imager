# Copy to .env.x-activity.local. This local file is ignored by Git.
X_CLIENT_ID=
# Required for Web App / Automated App clients. Leave empty for a Native App.
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8788/callback
IMAGER_API_URL=http://localhost:3000
IMAGER_SOURCE_ID=
# Optional. Used by replay, printed by listen after authentication.
X_USER_ID=
