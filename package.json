{
  "name": "solid-imager-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/client",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --filter @solid-imager/server dev",
    "build": "bun --filter '*' build",
    "start": "bun --filter @solid-imager/server start",
    "deps:update:aube": "aube update -r",
    "lint:boundaries": "oxlint --config tools/workspace-imports.oxlint.json --disable-nested-config apps packages",
    "lint": "bun run lint:boundaries && oxlint apps/*/src packages/*/src",
    "check": "bun run lint:boundaries && oxlint --fix apps/*/src packages/*/src && oxfmt --write apps/*/src packages/*/src && bun run typecheck && bun run design:lint",
    "design:lint": "designmd lint DESIGN.md",
    "format": "oxfmt --write apps/*/src packages/*/src",
    "test": "node tools/workspace-imports.test.mjs && bun run --cwd apps/server test:x-activity && vitest run",
    "test:e2e": "bun run --cwd apps/server test:e2e",
    "typecheck": "bun --filter '*' typecheck && tsc -p tools/tsconfig.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@shadcn/lint": "^0.2.3",
    "@tanstack/cli": "0.72.0",
    "@types/node": "26.6.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nitro": "npm:nitro-nightly@3.0.1-20261024-005652-6bccaad1",
    "oxfmt": "0.74.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "nitro": "npm:nitro-nightly@3.0.1-20261024-005652-6bccaad1"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "youtube-dl-exec",
    "ffmpeg-static",
    "dghs-imgutils-rs",
    "sharp"
  ],
  "lint-staged": {
    "apps/**/src/**/*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "packages/**/src/**/*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ]
  }
}
