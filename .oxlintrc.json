{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["eslint", "unicorn", "typescript", "oxc", "jsx-a11y"],
	"rules": {
		"no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"caughtErrors": "none",
				"ignoreRestSiblings": true
			}
		],
		"no-restricted-imports": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-deprecated": "warn",
		"typescript/no-floating-promises": "warn",
		"typescript/no-misused-promises": "warn",
		"typescript/no-unsafe-argument": "warn",
		"typescript/no-unsafe-assignment": "warn",
		"typescript/no-unsafe-call": "warn",
		"typescript/no-unsafe-member-access": "warn",
		"typescript/no-unsafe-return": "warn",
		"typescript/no-non-null-assertion": "warn",
		"oxc/no-barrel-file": "off",
		"jsx-a11y/no-redundant-roles": "error",
		"jsx-a11y/label-has-associated-control": "warn",
		"jsx-a11y/prefer-tag-over-role": "warn",
		"shadcn/no-arbitrary-values": "warn",
		"shadcn/no-raw-colors": "warn",
		"shadcn/no-inline-styles": "warn",
		"shadcn/no-unknown-classes": "warn",
		"shadcn/no-restyle": ["warn", { "allow": ["layout"] }],
		"shadcn/require-static-classes": "warn"
	},
	"options": {
		"typeAware": true
	},
	"ignorePatterns": [
		"**/node_modules",
		"**/dist",
		"**/gen",
		"**/.output",
		"**/db-data",
		"**/db-data*",
		"**/.worktree",
		"**/routeTree.gen.ts"
	],
	"jsPlugins": ["@shadcn/lint"],
	"settings": {
		"shadcn": {
			"ui": "@solid-imager/ui",
			"componentImports": ["^@solid-imager/ui(?:/|$)"],
			"note": "Follow DESIGN.md and prefer the existing Tailwind theme tokens and shared UI components."
		}
	},
	"overrides": [
		{
			"files": ["apps/xtracter/src/**/*.ts", "apps/xtracter/src/**/*.tsx"],
			"env": { "browser": true, "webextensions": true },
			"globals": { "chrome": "readonly" },
			"rules": {
				"shadcn/no-arbitrary-values": "off",
				"shadcn/no-raw-colors": "off",
				"shadcn/no-inline-styles": "off",
				"shadcn/no-unknown-classes": "off",
				"shadcn/no-restyle": "off",
				"shadcn/require-static-classes": "off"
			}
		},
		{
			"files": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/tests/**/*.ts",
				"**/tests/**/*.tsx"
			],
			"env": { "vitest": true },
			"rules": {
				"typescript/no-explicit-any": "off",
				"typescript/unbound-method": "off",
				"typescript/no-unsafe-argument": "off",
				"typescript/no-unsafe-assignment": "off",
				"typescript/no-unsafe-call": "off",
				"typescript/no-unsafe-member-access": "off",
				"typescript/no-unsafe-return": "off"
			}
		},
		{
			"files": ["**/__mocks__/**/*.ts", "**/__mocks__/**/*.tsx"],
			"rules": {
				"typescript/no-unsafe-argument": "off",
				"typescript/no-unsafe-assignment": "off",
				"typescript/no-unsafe-call": "off",
				"typescript/no-unsafe-member-access": "off",
				"typescript/no-unsafe-return": "off"
			}
		},
		{
			"files": ["**/routeTree.gen.ts"],
			"rules": { "typescript/no-explicit-any": "off" }
		},
		{
			"files": ["packages/ui/src/**"],
			"rules": { "shadcn/no-restyle": "off" }
		},
		{
			"files": [
				"packages/ui/src/layouts/command-center.tsx",
				"packages/ui/src/router-status.tsx",
				"packages/ui/src/screens/jobs-screen.tsx"
			],
			"rules": { "jsx-a11y/prefer-tag-over-role": "off" }
		},
		{
			"files": [
				"packages/ui/src/media-viewer.tsx",
				"packages/ui/src/source-media-grid.tsx",
				"packages/ui/src/screens/source-media-screen.tsx",
				"packages/ui/src/thumbnail-image.tsx"
			],
			"rules": { "jsx-a11y/no-noninteractive-element-interactions": "off" }
		},
		{
			"files": [
				"packages/ui/src/async-state.tsx",
				"packages/ui/src/skeleton.tsx",
				"packages/ui/src/router-status.tsx",
				"packages/ui/src/media-card-item.tsx",
				"packages/ui/src/command.tsx",
				"packages/ui/src/screens/jobs-screen.tsx",
				"apps/tauri/src/components/media/thumbnail-image.tsx",
				"apps/server/src/components/media/thumbnail-image.tsx",
				"apps/server/src/components/media/preset-manager.tsx"
			],
			"rules": { "shadcn/require-static-classes": "off" }
		},
		// tsgolint currently resolves TanStack's generated file-route registration as `error` in these files.
		// TypeScript's own project checks pass, so suppress only the resulting unsafe-type diagnostics here.
		{
			"files": [
				"apps/server/src/routes/index.tsx",
				"apps/server/src/routes/$.tsx",
				"apps/server/src/routes/about.tsx",
				"apps/server/src/routes/config.tsx",
				"apps/server/src/routes/design-lab.tsx",
				"apps/server/src/routes/jobs.tsx",
				"apps/server/src/routes/manager.tsx",
				"apps/server/src/routes/search.tsx",
				"apps/server/src/routes/api/health.ts",
				"apps/server/src/routes/sources/index.tsx",
				"apps/server/src/routes/api/rpc.$.ts",
				"apps/server/src/routes/api/jobs.$jobId.artifact.ts",
				"apps/server/src/routes/api/sources.$mediaSourceId.$mediaId.ts",
				"apps/server/src/routes/api/sources.$mediaSourceId.thumbnail.$mediaId.ts",
				"apps/server/src/routes/docs/scalar/index.tsx"
			],
			"rules": { "typescript/no-unsafe-assignment": "off" }
		},
		{
			"files": [
				"apps/server/src/hooks/use-media-source-events.ts",
				"apps/server/src/components/layout/app-shell.tsx",
				"apps/server/src/components/home-route.tsx",
				"apps/server/src/components/pages/search-content.tsx",
				"apps/server/src/components/media/media-actions.tsx",
				"apps/server/src/router.tsx",
				"apps/server/src/routes/__root.tsx",
				"apps/server/src/routes/docs/swagger/index.tsx",
				"apps/server/src/routes/sources/$mediaSourceId/components/source-media-controller.tsx",
				"apps/server/src/routes/sources/$mediaSourceId/components/source-media-page.tsx",
				"apps/server/src/routes/sources/$mediaSourceId/index.tsx",
				"apps/server/src/routes/sources/$mediaSourceId/$mediaId/index.tsx"
			],
			"rules": {
				"typescript/no-unsafe-argument": "off",
				"typescript/no-unsafe-assignment": "off",
				"typescript/no-unsafe-call": "off",
				"typescript/no-unsafe-member-access": "off",
				"typescript/no-unsafe-return": "off"
			}
		},
		{
			"files": ["packages/core/src/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"@solid-imager/application",
									"@solid-imager/application/**",
									"@solid-imager/client",
									"@solid-imager/client/**",
									"@solid-imager/db",
									"@solid-imager/db/**",
									"@solid-imager/ui",
									"@solid-imager/ui/**",
									"~/**"
								],
								"message": "Keep core independent from application and infrastructure packages."
							}
						]
					}
				]
			}
		},
		{
			"files": ["packages/application/src/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"@solid-imager/client",
									"@solid-imager/client/**",
									"@solid-imager/db",
									"@solid-imager/db/**",
									"@solid-imager/ui",
									"@solid-imager/ui/**",
									"~/**"
								],
								"message": "Keep application code independent from client, database, and UI packages."
							}
						]
					}
				]
			}
		},
		{
			"files": ["packages/db/src/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"@solid-imager/application",
									"@solid-imager/application/**",
									"@solid-imager/client",
									"@solid-imager/client/**",
									"@solid-imager/ui",
									"@solid-imager/ui/**",
									"~/**"
								],
								"message": "Keep database infrastructure independent from application, client, and UI packages."
							}
						]
					}
				]
			}
		},
		{
			"files": ["packages/ui/src/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"@solid-imager/application",
									"@solid-imager/application/**",
									"@solid-imager/client",
									"@solid-imager/client/**",
									"@solid-imager/db",
									"@solid-imager/db/**",
									"~/**"
								],
								"message": "Keep shared UI independent from application, client, and database packages."
							}
						]
					}
				]
			}
		},
		{
			"files": ["packages/client/src/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"@solid-imager/application",
									"@solid-imager/application/**",
									"@solid-imager/core",
									"@solid-imager/core/**",
									"@solid-imager/db",
									"@solid-imager/db/**",
									"@solid-imager/ui",
									"@solid-imager/ui/**",
									"~/**"
								],
								"message": "Keep the API client independent from application, domain, database, and UI packages."
							}
						]
					}
				]
			}
		}
	]
}
