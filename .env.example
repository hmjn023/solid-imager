# Use 127.0.0.1 for PostgreSQL via mise Daemons or Compose.
DB_HOST=pglite
# PGPORT=5432
POSTGRES_DB=solid_imager
POSTGRES_USER=solid_imager
POSTGRES_PASSWORD=solid_imager_dev
# PostgreSQL driver: bun-sql (default) or node-postgres (fallback for
# extensions/features that Bun.SQL does not support yet).
DB_POSTGRES_DRIVER=bun-sql

# API Configuration
# Optional Danbooru viewer authentication (server only; both values are required).
# Without these, the viewer uses Danbooru's anonymous access and search limits.
# DANBOORU_LOGIN=
# DANBOORU_API_KEY=
# API_BASE_URL=http://localhost:3000

# Additional trusted HTTP MCP hostnames, comma-separated, without ports.
# MCP_ALLOWED_HOSTS=imager.example.com

# External browser origin for REST requests behind a TLS-terminating reverse proxy.
# API_PUBLIC_ORIGIN=https://imager.example.com

# nginx configuration. mise Daemons defaults to nginx.conf.example.
# NGINX_CONFIG=./nginx.conf
# NGINX_PORT=80
# NGINX_TLS_PORT=443

# Bind Bun to the loopback address behind nginx.
NITRO_HOST=127.0.0.1
# NITRO_PORT=3000

# Local app connects to a separately running inference service.
# CONFIG_AI_BASE_URL=http://127.0.0.1:3001

# Production Compose builds separate app and inference images.
# APP_IMAGE=solid-imager-app:latest
# INFERENCE_IMAGE=solid-imager-inference:latest
# INFERENCE_BASE_URL=http://inference:3001
# INFERENCE_ORT_DIR=/opt/onnxruntime/lib
# INFERENCE_PROVIDER=cpu
# INFERENCE_DEVICE=
# INFERENCE_TOKEN=
