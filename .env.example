# Database Configuration
#DB_HOST=localhost
# pglite to test environment
DB_HOST=pglite
DB_PORT=5432
DB_DATABASE=solid_imager
DB_USER=your_database_user
DB_PASSWORD=your_database_password
# PostgreSQL driver: bun-sql (default) or node-postgres (fallback for
# extensions/features that Bun.SQL does not support yet).
DB_POSTGRES_DRIVER=bun-sql

# API Configuration
# API_BASE_URL=http://localhost:3000

# Server binding (0.0.0.0 binds to all IPv4 interfaces; remove to default to ::)
NITRO_HOST=0.0.0.0

# Production Compose uses the host-built application as a bind mount.
# Set this to a path visible on the deployment host when the build is done elsewhere.
# APP_ARTIFACT_DIR=/srv/solid-imager
# APP_RUNTIME_IMAGE=oven/bun:1.4.0-debian
