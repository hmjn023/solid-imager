# Database configuration for mise Daemons.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=solid_imager
DB_USER=solid_imager
DB_PASSWORD=solid_imager_dev
# PostgreSQL driver: bun-sql (default) or node-postgres (fallback for
# extensions/features that Bun.SQL does not support yet).
DB_POSTGRES_DRIVER=bun-sql

# API Configuration
# Optional Danbooru viewer authentication (server only; both values are required).
# Without these, the viewer uses Danbooru's anonymous access and search limits.
# DANBOORU_LOGIN=
# DANBOORU_API_KEY=
# API_BASE_URL=http://localhost:3000

# Additional trusted HTTP MCP hostnames, comma-separated, without ports.
# MCP_ALLOWED_HOSTS=imager.example.com

# External browser origin for REST requests behind a TLS-terminating reverse proxy.
REST_PUBLIC_ORIGIN=http://127.0.0.1:8080

# nginx configuration for mise Daemons. Defaults to nginx.dev.conf.example.
# NGINX_CONFIG=./nginx.conf

# Bind Bun to the loopback address behind nginx.
NITRO_HOST=127.0.0.1
NITRO_PORT=13000

# Production Compose uses the host-built application as a bind mount.
# Set this to a path visible on the deployment host when the build is done elsewhere.
# APP_ARTIFACT_DIR=/srv/solid-imager
# APP_RUNTIME_IMAGE=oven/bun:1.4.0-debian
